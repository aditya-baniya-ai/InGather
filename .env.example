# Copy to .env and fill in. Never commit .env.

# --- Meta Model API (backend only, never exposed to the browser) ---
MODEL_API_KEY=
META_MODEL=muse-spark-1.3
META_IMAGE_MODEL=muse-image-1.0
META_VOICE_MODEL=muse-voice-transcribe-1.0
META_MODEL_BASE_URL=https://api.meta.ai/v1
META_MODEL_TIMEOUT_SECONDS=60
AGENT_MAX_TOOL_ROUNDS=6
AGENT_MAX_CANDIDATES=12
AGENT_REASONING_EFFORT=minimal

# --- App ---
APP_ENV=development
DEMO_MODE=true
ALLOW_REAL_WORLD_MEETUPS=false
ENABLE_STRANGER_DISCOVERY=false
ENABLE_REAL_IDENTITY_VERIFICATION=false
# --- Stripe Identity (optional; test keys from dashboard.stripe.com -> Developers) ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
PUBLIC_BASE_URL=http://localhost:8000

JWT_SECRET=change-me-to-a-long-random-string
CORS_ORIGINS=http://localhost:5173,http://localhost:8000

# Local runs use sqlite; docker-compose overrides this with its Postgres URL.
DATABASE_URL=sqlite:///./ingather.db
