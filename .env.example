# Copy to .env and fill in. Never commit .env.

# --- Meta Model API (backend only, never exposed to the browser) ---
MODEL_API_KEY=
META_MODEL=muse-spark-1.3
META_IMAGE_MODEL=muse-image-1.0
META_VOICE_MODEL=muse-voice-transcribe-1.0
META_MODEL_BASE_URL=https://api.meta.ai/v1
META_MODEL_TIMEOUT_SECONDS=60
# Muse Spark only drafts plans from free text; group matching runs on the server's own ML model (no API calls).
INTAKE_REASONING_EFFORT=minimal

# --- App ---
APP_ENV=development
DEMO_MODE=true
# Fictional Austin residents and open groups for the Home feed, seeded in DEMO_MODE (0 = none).
DEMO_SYNTHETIC_USERS=1000
DEMO_OPEN_GROUPS=150
ALLOW_REAL_WORLD_MEETUPS=false
ENABLE_STRANGER_DISCOVERY=false
ENABLE_REAL_IDENTITY_VERIFICATION=false
# Public-event geocoding and nearby places via OpenStreetMap (no API key).
VENUE_SEARCH_ENABLED=true
# Optional: Google Places (New) for the group venue vote: real nearby places in seconds, exact pins, photos,
# ratings and opening hours. Server-side only; never put it in the frontend.
GOOGLE_MAPS_API_KEY=
# --- Stripe Identity (optional; test keys from dashboard.stripe.com -> Developers) ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
PUBLIC_BASE_URL=http://localhost:8000

JWT_SECRET=change-me-to-a-long-random-string
CORS_ORIGINS=http://localhost:5173,http://localhost:8000

# Local runs use sqlite.
DATABASE_URL=sqlite:///./ingather.db

# --- Supabase Auth: sign-up and sign-in for real people ---
# From Supabase > Project Settings > API. The anon (publishable) key is public by design; never put the
# service_role key here. The app's data (plans, groups, the 1,000 demo residents) stays in DATABASE_URL.
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Only for projects still on the legacy shared JWT secret (Project Settings > API > JWT Settings).
# SUPABASE_JWT_SECRET=

# Optional: use a Supabase Postgres connection from Docker instead of the local
# Postgres container. Copy the connection string from Supabase > Connect.
# Prefer the session pooler connection for local Docker development.
# SUPABASE_DATABASE_URL=postgresql+psycopg://postgres.<project-ref>:<password>@<pooler-host>:5432/postgres?sslmode=require
